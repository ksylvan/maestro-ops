# Copy this file to .env and edit the values. The scripts source a sibling
# .env automatically, so no shell dotfile setup is necessary. .env is
# git-ignored, so a local override does not reach the repository.

# --- Maestro CLI location (for developers of Maestro itself) ---

# Path to the maestro-cli.js to run. When set, this wins over the installed
# app, and MAESTRO_USER_DATA is honored as given. Point it at a checked-out
# rc or preview build.
export MAESTRO_CLI_JS="$HOME/src/worktrees/Maestro/preview/dist/cli/maestro-cli.js"

# Maestro data directory. Set this to the dev build's data dir when you run
# against a preview build.
export MAESTRO_USER_DATA="$HOME/Library/Application Support/maestro-dev"

# Legacy alias for MAESTRO_CLI_JS, still honored by maestro_watch.sh. Prefer
# MAESTRO_CLI_JS above; set this only for older setups.
# export MAESTRO_JS="$HOME/src/worktrees/Maestro/preview/dist/cli/maestro-cli.js"

# --- Directory model ---

# Root directory for base clones and worktrees.
# export MAESTRO_REPOS_DIR="$HOME/src"  # (default)

# --- Repository search ---

# Colon-separated GitHub owners/orgs to try when a repository name must be
# resolved and cloned. When empty, maestro_pr.sh defaults to your
# authenticated GitHub user (gh api user).
# export MAESTRO_GH_SEARCH="danielmiessler:ksylvan"  # (default: your GitHub user)

# --- Code Review playbooks (maestro_pr.sh) ---

# GitHub repository to clone when the local playbooks directory is missing.
# export MAESTRO_PLAYBOOKS_GH_REPO="RunMaestro/Maestro-Playbooks"  # (default)

# Local directory for the playbooks.
# export MAESTRO_PLAYBOOKS_DIR="$HOME/src/Maestro-Playbooks"  # (default: ${MAESTRO_REPOS_DIR}/Maestro-Playbooks)

# --- Agents ---

# Agent type used when a script call does not name one.
# export MAESTRO_DEFAULT_AGENT_TYPE="claude"  # (default)
